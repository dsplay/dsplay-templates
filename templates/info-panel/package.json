{
  "name": "dsplay-template-info-panel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@dsplay/react-template-utils": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "scripts": {
    "start": "vite",
    "build": "npm run linter && vite build",
    "build:panel": "npm run linter && vite build --mode panel",
    "build:spotlight": "npm run linter && vite build --mode spotlight",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "linter": "eslint src",
    "linter:fix": "eslint src --fix",
    "zip": "npm run zip:panel && npm run zip:spotlight",
    "zip:panel": "npm run build:panel && node scripts/pack.mjs panel",
    "zip:spotlight": "npm run build:spotlight && node scripts/pack.mjs spotlight"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all",
    "Chrome >= 45",
    "Android >= 4.4"
  ],
  "devDependencies": {
    "@dsplay/template-manifest": "1.0.5",
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-legacy": "8.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "archiver": "8.0.0",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unicorn": "65.0.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "sass": "1.105.1",
    "terser": "5.51.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
