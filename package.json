{
  "name": "dsplay-templates",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DSPLAY HTML templates, boilerplates and the libraries they share",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "packages/*",
    "templates/*",
    "boilerplates/*"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:repo": "node --test tools/supply-chain.test.mjs",
    "linter": "turbo run linter",
    "zip": "turbo run zip",
    "new-template": "node tools/new-template.mjs",
    "check-versions": "node tools/check-versions.mjs",
    "validate-boilerplates": "node tools/validate-boilerplates.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && node tools/check-versions.mjs --fix && npm install --package-lock-only",
    "release": "turbo run build --filter=./packages/* && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "semver": "7.8.5",
    "turbo": "2.11.7"
  }
}
